{
  "_说明": "这是远程配置下发文件。你在本地编辑这个文件，然后执行 node tools/publish.js config 推送，24小时内老人设备自动生效。ver 由脚本自动递增，不要手动改。",
  "ver": 1,
  "channels": {
    "_说明": "直播源列表。priority 越小越优先。同一频道出现在多个源里会按 normalizedName 合并为多线路。",
    "providers": [
      {
        "type": "api",
        "id": "main",
        "url": "https://你的域名.com/tvlive/channels",
        "enabled": false,
        "priority": 1,
        "_提示": "服务端 JSON 接口，最灵活。改源/改分组只改服务器，不用发 App 版本。V1 先关闭，V1.1 配上服务器再开"
      },
      {
        "type": "m3u8",
        "id": "official",
        "url": "https://你的域名.com/tvlive/iptv.m3u",
        "enabled": false,
        "priority": 2,
        "_提示": "m3u8 订阅。填你自己服务端转发的地址，不要用公开源（不稳定）"
      },
      {
        "type": "js",
        "id": "js1",
        "url": "https://你的域名.com/tvlive/spider.js",
        "enabled": false,
        "priority": 3,
        "_提示": "JS 动态解析。攻击面最大，V1 保持关闭。V2 建议把解析逻辑移到服务端"
      },
      {
        "type": "m3u8",
        "id": "fallback",
        "url": "",
        "enabled": false,
        "priority": 99,
        "builtin": true,
        "_提示": "留空则使用 App 内置兜底配置（assets 里的 44 台）。全通道失效时自动接管，保证开不了机的情况不发生"
      }
    ],
    "groups": [
      {
        "id": "cctv",
        "name": "央视",
        "order": 1
      },
      {
        "id": "satellite",
        "name": "卫视",
        "order": 2
      },
      {
        "id": "local",
        "name": "地方台",
        "order": 3
      },
      {
        "id": "other",
        "name": "其他",
        "order": 4
      }
    ]
  },
  "epg": {
    "_说明": "节目单。XMLTV 格式，App 用流式解析（不会 OOM）。只存当天与未来 7 天。",
    "sources": [
      "https://epg.112114.xyz/pp.xml"
    ],
    "refreshHours": 12
  },
  "features": {
    "jsProviderEnabled": false,
    "autoUpdateChannel": true,
    "autoUpdateEpg": true,
    "showNotice": true
  },
  "ui": {
    "_说明": "所有文案和字号都能远程改，不用发版。比如临时通知、字号调大、换分组方式。",
    "defaultFontIndex": 1,
    "fontScaleOptions": [
      0.85,
      1,
      1.15,
      1.3
    ],
    "showWeather": false,
    "showDate": true,
    "channelLayoutColumns": 5,
    "noticeBanner": "",
    "bottomHint": "← 频道分组　OK 播放　菜单 线路",
    "loadingText": "正在加载…",
    "noSignalText": "这个台暂时看不了，换一个试试",
    "defaultChannel": "CCTV-1"
  },
  "update": {
    "_说明": "升级配置。apkPath 指向仓库里的 apk/ 目录。sha256 由发布脚本自动填。",
    "versionName": "1.0.0",
    "versionCode": 1,
    "force": false,
    "apkPath": "",
    "size": 0,
    "sha256": "",
    "title": "V1.0.0",
    "notes": [
      "首次发布"
    ],
    "checkIntervalHours": 24
  },
  "limits": {
    "_说明": "目标机是 Android 4.4.2 + 1GB 内存，频道上限必须压住，否则会 OOM。",
    "maxChannels": 1000,
    "maxUrlsPerChannel": 3,
    "preferH264": true,
    "h265ScorePenalty": -10
  }
}